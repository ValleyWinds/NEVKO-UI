  "Conditions": {
    "贡献者徽章": {
      "description": "在 Boosty 支持者和帮助过主题的人（反馈 bug、修复、点子）名字旁显示徽章。只有使用 NEVKO-UI 的人能看到",
      "default": "yes",
      "tab": "通用",
	  "section": "贡献者",
      "values": {
        "no": {},
        "yes": {
          "TargetJs": {
            "affects": ["^.*$", ".*"],
            "src": "Credits/Badges for Contributors.js"
          }
        }
      }
    },

    "头像圆角": {
      "description": "Steam 各处头像的圆角程度，从方形到完整的圆形",
